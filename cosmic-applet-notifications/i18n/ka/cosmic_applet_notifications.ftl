show-less = ნაკლების ჩვენება
clear-group = ჯგუფის გასუფთავება
notification-settings = გაფრთხილებების მორგება...
no-notifications = გაფრთხილებების გარეშე
clear-all = ყველა გაფრთხილების გასუფთავება
do-not-disturb = არ შემაწუხოთ
show-more = კიდევ { $more }-ის ჩვენება
hours-ago =
    { $duration ->
        [0] ახლა
        [one] 1 საათის წინ
       *[other] { $duration } საათის წინ
    }
minutes-ago =
    { $duration ->
        [0] ახლა
        [one] 1 წუთის წინ
       *[other] { $duration } წუთის წინ
    }
